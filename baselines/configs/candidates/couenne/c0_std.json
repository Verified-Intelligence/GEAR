{
  "name": "c0_std",
  "solver": "couenne",
  "options": "bonmin.time_limit={time} outlev=1",
  "native": "feas_tolerance 1e-6\nbonmin.allowable_fraction_gap 1e-4\nbonmin.allowable_gap 1e-5\n",
  "threads": 1,
  "jobs": 16,
  "env": {
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "BLIS_NUM_THREADS": "1",
    "NUMEXPR_NUM_THREADS": "1"
  },
  "notes": "standard tolerances (paper rule: OBBT/aggr FBBT off above 100 vars)",
  "stage": "settings",
  "select": true
}
