{
  "name": "s0_std",
  "solver": "scip",
  "options": "lim:time={time} lp:threads=1 tech:outlev=1 tech:timing=2 alg:concurrent=1 par:minnthreads={threads} par:maxnthreads={threads} par:mode=0",
  "native": "numerics/feastol = 1e-6\nlimits/gap = 1e-4\nlimits/absgap = 1e-5\n",
  "threads": 16,
  "jobs": 1,
  "env": {
    "OMP_NUM_THREADS": "16",
    "OPENBLAS_NUM_THREADS": "16",
    "MKL_NUM_THREADS": "16",
    "BLIS_NUM_THREADS": "16",
    "NUMEXPR_NUM_THREADS": "16"
  },
  "notes": "standard tolerances, 16-way concurrent",
  "stage": "settings",
  "select": true
}
